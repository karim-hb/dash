  "scripts": {
    "dev": "bash scripts/dev-start.sh",
    "dev:kill": "echo 'Killing all Next.js processes...'; pkill -f 'next dev' 2>/dev/null || true; pkill -f 'next' 2>/dev/null || true; rm -f .next/dev/lock 2>/dev/null || true; echo 'Cleanup complete.'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "server": "PORT=3005 UI_WS_PORT=3006 tsx src/server/index.ts",
    "ws-server": "UI_WS_PORT=3007 tsx src/server/ws-server.ts",
    "aave:pull-history": "tsx src/server/jobs/pullHistory.ts",
    "ingest:amm:historical": "tsx src/server/indexers/amm/customAmm.historical.ts",
