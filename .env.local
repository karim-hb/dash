# Tracker Web Configuration
EXECUTION_WS_URL=ws://127.0.0.1:8545
MONGO_URL=mongodb://127.0.0.1:27017/tracker
JWT_PATH=/home/hb/network/jwt.hex

# Optional: Enable 4byte API for unknown selectors (default: false for local-only)
ENABLE_4BYTE=false

# UI refresh interval in milliseconds
UI_REFRESH_MS=200

# Receipt fetch concurrency
RECEIPT_CONCURRENCY=8

# Token discovery concurrency
TOKEN_CONCURRENCY=4
